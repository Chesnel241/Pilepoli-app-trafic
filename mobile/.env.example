# Adresse du moteur Pilepoil.
# En local sur un téléphone : l'IP de ton ordinateur (ex. http://192.168.1.20:8787) ou l'adresse du tunnel.
# En production : https://api.pilepoil.fr (réglé dans eas.json).
EXPO_PUBLIC_ENGINE_URL=http://localhost:8787

# Facultatif : même valeur que ACCESS_TOKEN dans engine/.env (anti-abus, pas un vrai secret).
EXPO_PUBLIC_ENGINE_KEY=

# 1 = autoriser les données simulées si le moteur ne répond pas (automatique en développement).
EXPO_PUBLIC_DEMO=
