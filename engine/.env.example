# Clé API PRIM (https://prim.iledefrance-mobilites.fr), à créer sur ton compte.
# Ne jamais la committer : copie ce fichier en .env et remplis-le.
PRIM_API_KEY=

# Facultatif : jeton « Jeux de données » (PRIM > Mes jetons d'authentification > Jeux de données).
# Sert aux jeux à accès restreint ; l'appli marche sans.
PRIM_DATASET_TOKEN=

# "mock" = données simulées (par défaut), "prim" = vraies données IDFM
DATA_MODE=mock

PORT=8787

# --- Production (VPS) ---
# Derrière Nginx : 1 pour lire l'adresse réelle du client (X-Forwarded-For).
TRUST_PROXY=0
# Requêtes par minute et par adresse IP.
RATE_PER_MIN=120
# Facultatif : clé anti-abus que l'appli envoie (en-tête x-pilepoil-key). Même valeur que EXPO_PUBLIC_ENGINE_KEY côté appli.
ACCESS_TOKEN=
# 1 pour garder aussi le journal brut des relevés (data/observations.jsonl, archivé à 50 Mo).
HISTORY_LOG=0
